{
    "telemetry.telemetryLevel": "off",
    "editor.fontSize": 16,
    "editor.fontFamily": "'Monolisa Medium'",
    "editor.fontLigatures": "'calt', 'ss02','ss03', 'zero', 'onum','ss10','ss12','ss14','ss15','ss16'",
    "editor.fontVariations": true,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "entity.name.type.class",
                    "keyword",
                    "constant",
                    "storage.modifier",
                    "storage.type.class.js"
                ],
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "invalid",
                    "keyword.operator",
                    "constant.numeric.css",
                    "keyword.other.unit.px.css",
                    "constant.numeric.decimal.js",
                    "constant.numeric.json"
                ],
                "settings": {
                    "fontStyle": ""
                }
            }
        ]
    },
    "editor.lineHeight": 20,
    "editor.minimap.enabled": false,
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "smooth",
    "window.zoomLevel": 1.5,
    "workbench.list.smoothScrolling": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.sideBar.location": "right",
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.editor.tabSizing": "fit",
    "workbench.tips.enabled": false,
    "explorer.compactFolders": false,
    "terminal.integrated.smoothScrolling": true,
    "files.autoSave": "onFocusChange",
    "[jsonc]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "terminal.integrated.fontFamily": "GeistMono NF",
    "terminal.integrated.fontSize": 16,
    "custom-ui-style.font.sansSerif": "'Recoleta'",
    "extensions.ignoreRecommendations": true,
    "git.autofetch": true,
    "security.workspace.trust.untrustedFiles": "open",
    "window.customTitleBarVisibility": "auto",
    "window.titleBarStyle": "custom",
    "custom-ui-style.background.opacity": 0.1,
    "animations.Install-Method": "Custom UI Style",
    "custom-ui-style.external.imports": [
        "file:///Users/rene/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js"
    ],
    "git.confirmSync": false,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gemini-3.1-pro-preview",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "zenMode.fullScreen": false,
    "zenMode.hideLineNumbers": false,
    "zenMode.centerLayout": false,
    "zenMode.hideStatusBar": true,
    "zenMode.showTabs": "none",
    "workbench.editor.empty.hint": "hidden",
    "GitLive.Special branches": "main|master|trunk|dev|develop|qa|test|release[-/].*",
    "docker.extension.enableComposeLanguageServer": false,
    "editor.renderLineHighlight": "gutter",
    "animations.Enabled": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnSave": true,
    "files.associations": {
        "*.vue": "vue"
    },
    "zenMode.hideActivityBar": false,
    "workbench.statusBar.visible": false,
    "diffEditor.codeLens": true,
    "chat.tools.terminal.autoApprove": {
        "bunx": true
    },
    "chat.mcp.gallery.enabled": true,
    "makefile.configureOnOpen": false,
    "files.watcherExclude": {
        "**/.bloop": true,
        "**/.metals": true
    },
    "git.openRepositoryInParentFolders": "always",
    "sonarlint.automaticAnalysis": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "go.toolsManagement.autoUpdate": true,
    "custom-ui-style.stylesheet": {
        ".monaco-workbench .editor-group-container": {
            "border-radius": "12px",
            "overflow": "hidden",
            "background-color": "var(--cus-editor-bg)"
        },
        ".monaco-workbench .editor-group-container .monaco-scrollable-element": {
            "border-radius": "12px",
            "background-color": "var(--cus-editor-bg)"
        },
        ".monaco-workbench .activitybar .monaco-action-bar .action-item": {
            "border-radius": "8px"
        },
        ".monaco-workbench .activitybar .monaco-action-bar .action-item .action-label": {
            "border-radius": "8px"
        },
        ".monaco-workbench .part.sidebar": {
            "border-radius": "8px",
            "overflow": "hidden"
        },
        ".monaco-workbench .part.panel": {
            "border-radius": "8px",
            "overflow": "hidden"
        },
        ".monaco-workbench .part.statusbar": {
            "border-radius": "8px 8px 0 0"
        },
        ".monaco-text-button": {
            "border-radius": "6px !important"
        },
        ".monaco-button-dropdown > .monaco-button.monaco-text-button": {
            "border-radius": "6px 0 0 6px !important"
        },
        ".monaco-button-dropdown > .monaco-button.monaco-dropdown-button": {
            "border-radius": "0 6px 6px 0 !important"
        },
        ".monaco-inputbox, .monaco-findInput .monaco-inputbox, .monaco-workbench .quick-input-widget": {
            "border-radius": "6px"
        },
        ".monaco-workbench > .notifications-center": {
            "border-radius": "8px !important",
            "overflow": "hidden"
        },
        ".monaco-workbench .notification-toast-container .monaco-list-row": {
            "border-radius": "8px"
        },
        ".monaco-workbench .part.editor .editor-group-container .title": {
            "background-color": "transparent",
            "padding": "6px 8px",
            "gap": "4px",
            "display": "flex",
            "flex-direction": "column",
            "align-items": "stretch"
        },
        ".monaco-workbench .part.editor .editor-group-container .title .tabs-container > .tab": {
            "border-radius": "12px",
            "padding-bottom": "5px"
        },
        ".monaco-workbench .part.editor .editor-group-container .title .breadcrumbs-control": {
            "border-radius": "10px",
            "overflow": "hidden"
        },
        ".monaco-workbench .part": {
            "border-radius": "12px",
            "overflow": "hidden"
        },
        ".monaco-workbench .part > *": {
            "border-radius": "12px"
        },
        ".monaco-breadcrumbs": {
            "background-color": "transparent",
            "padding": "0",
            "max-width": "100%",
            "overflow": "hidden"
        },
        ".monaco-breadcrumbs .monaco-breadcrumb-item": {
            "border-radius": "999px",
            "padding": "2px 6px",
            "overflow": "hidden",
            "text-overflow": "ellipsis",
            "white-space": "nowrap"
        },
        ".tabs-and-actions-container.tabs-border-bottom": {
            "border-bottom": "none !important",
            "--tabs-border-bottom-color": "transparent !important"
        },
        ".tab.tab-border-bottom": {
            "border-bottom": "none !important",
            "--tab-border-bottom-color": "transparent !important"
        },
        ".tab-border-bottom-container": {
            "display": "none !important"
        },
        ".tabs-and-actions-container": {
            "box-shadow": "none !important"
        },
        ".monaco-workbench .part.editor > .content .container": {
            "box-shadow": "none !important"
        },
        ".monaco-editor, .monaco-editor .overflow-guard": {
            "border-top-left-radius": "20px !important",
            "border-top-right-radius": "20px !important"
        },
        ".tab-border-top-container": {
            "display": "none !important"
        },
        ".tabs-container > .tab": {
            "margin-right": "4px !important",
            "border-right": "none !important",
            "border-radius": "12px"
        },
        ".tabs-container > .tab:last-child": {
            "margin-right": "0px !important"
        },
        ".tabs-container": {
            "display": "flex !important",
            "gap": "0px !important"
        },
        ".margin-view-overlays": {
            "border-radius": "20px 0 0 20px !important",
            "overflow": "hidden !important",
            "margin-right": "10px !important"
        },
        ".line-numbers": {
            "border-radius": "6px !important"
        },
        ".current-line-margin": {
            "border-radius": "6px !important"
        }
    },
    "editor.stickyScroll.enabled": false,
    "vs-kubernetes": {
        "vscode-kubernetes.minikube-path-mac": "/Users/rene/.vs-kubernetes/tools/minikube/darwin-arm64/minikube"
    },
    "workbench.colorCustomizations": {},
    "githubPullRequests.pullBranch": "never",
    "githubLocalActions.dockerDesktopPath": "/Applications/Docker.app",
    "terminal.integrated.initialHint": false,
    "window.commandCenter": false,
    "markdown-preview-github-styles.colorTheme": "auto",
    "markdown-preview-github-styles.darkTheme": "dark",
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://www.raycast.com/schemas/extension.json": true,
        "https://biomejs.dev": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "security.promptForLocalFileProtocolHandling": false,
    "sonarlint.connectedMode.connections.sonarcloud": [
        {
            "organizationKey": "diazdesandi",
            "connectionId": "diazdesandi",
            "region": "EU"
        },
        {
            "organizationKey": "stonerl",
            "connectionId": "stonerl",
            "region": "EU"
        }
    ],
    "sonarlint.ideLabsEnabled": true,
    "sonarlint.focusOnNewCode": false,
    "terminal.integrated.gpuAcceleration": "off",
    "window.systemColorTheme": "dark",
    "window.autoDetectColorScheme": false,
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "terminal.integrated.fontLigatures.enabled": true,
    "claudeCode.preferredLocation": "panel",
    "git.addAICoAuthor": "off",
    "chat.tips.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "pulumi-lsp.detectExtensionConflicts": false,
    "js/ts.updateImportsOnFileMove.enabled": "never",
    "workbench.productIconTheme": "fluent-icons",
    "workbench.browser.showInTitleBar": true,
    "workbench.iconTheme": "symbols",
    "cursor.cpp.disabledLanguages": [
        "plaintext",
        "scminput"
    ],
    "cursor.general.emailPrivacyEnabled": true,
    "cursor.composer.conversationDensity": "compact-ungrouped"
}